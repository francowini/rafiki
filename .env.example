# ==============================================================================
# Database Configuration
# ==============================================================================

# Local Development (Docker PostgreSQL)
# These variables are used when PARTNER_DB_HOST is NOT set
POSTGRES_DB=rafikis
POSTGRES_USER=rafikis
POSTGRES_PASSWORD=db  # ⚠️ Change in production!

# External Database (PlanetScale, Neon, AWS RDS, etc.)
# Uncomment these lines to use external database instead of local Docker PostgreSQL
# When PARTNER_DB_HOST is set, deploy.sh automatically disables local PostgreSQL (~256MB RAM saved)
#
# PlanetScale Example:
# PARTNER_DB_HOST=aws.connect.psdb.cloud
# PARTNER_DB_PORT=3306
# PARTNER_DB_USER=your_planetscale_username
# PARTNER_DB_PASSWORD=pscale_pw_xxxxxxxxxx
# PARTNER_DB_NAME=your_database
# PARTNER_DB_SSLMODE=require
# PARTNER_DB_DISABLETLS=false
#
# Neon/Supabase Example (PostgreSQL):
# PARTNER_DB_HOST=ep-xxx-xxx.us-east-2.aws.neon.tech
# PARTNER_DB_PORT=5432
# PARTNER_DB_USER=your_username
# PARTNER_DB_PASSWORD=your_password
# PARTNER_DB_NAME=neondb
# PARTNER_DB_SSLMODE=require
# PARTNER_DB_DISABLETLS=false
#
# Optional: Connection pool settings (adjust based on your plan limits)
# PARTNER_DB_MAXIDLECONNS=2
# PARTNER_DB_MAXOPENCONNS=10
#
# Troubleshooting "context deadline exceeded":
# 1. Verify direct connection: psql "postgresql://USER:PASS@HOST:PORT/DB?sslmode=require"
# 2. Check IP whitelist in database provider
# 3. Try PARTNER_DB_SSLMODE=disable temporarily (testing only!)
# 4. Run diagnostic: sudo ./devops/diagnose-planetscale.sh

# ==============================================================================
# Service Configuration
# ==============================================================================

# CORS Configuration
# Desarrollo: CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,*
# Producción: CORS_ALLOWED_ORIGINS=https://app.rafiki.lat,https://rafiki-frontend-*.vercel.app
CORS_ALLOWED_ORIGINS=*

# ==============================================================================
# Field-Level Encryption Configuration
# ==============================================================================

# Encryption key for sensitive user data (AES-256-GCM)
# REQUIRED for production deployment
#
# Key requirements:
# - Must be exactly 32 bytes (64 hex characters)
# - Generate with: openssl rand -hex 32
# - Store securely in password manager (key loss = permanent data loss!)
# - Never commit this key to version control
#
# Encrypted fields:
# - Moments: situation, thoughts, physicalSymptoms, behavior, consequences, valuesReflection
# - Thinks: content
#
# Example key generation:
# $ openssl rand -hex 32
# a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2
#
PARTNER_ENCRYPTION_KEY=

# ==============================================================================
# Anthropic API Configuration (for AI-guided validation)
# ==============================================================================

# Anthropic API key for Claude integration
# Get your key from: https://console.anthropic.com/
# Required for Telegram moment tracking AI validation
PARTNER_ANTHROPIC_APIKEY=

# Claude model to use (default: claude-haiku-4-5)
# Options:
#   claude-haiku-4-5            - $1/$5 per MTok (latest fast model)
#   claude-sonnet-4-5           - $3/$15 per MTok (balanced)
#   claude-3-haiku-20240307     - $0.25/$1.25 per MTok (cheapest, legacy)
# PARTNER_ANTHROPIC_MODEL=claude-haiku-4-5

# Maximum tokens for response (default: 500, max: 4096)
# PARTNER_ANTHROPIC_MAXTOKENS=500

# Temperature for response generation (default: 0.7)
# PARTNER_ANTHROPIC_TEMPERATURE=0.7
