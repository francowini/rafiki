meta {
  name: Ayuda telegram
  type: http
  seq: 21
}

post {
  url: http://localhost:3000/v1/telegram/webhook
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  X-Telegram-Bot-Api-Secret-Token: local-test-secret-12345
}

body:json {
  {
    "update_id": 1,
    "message": {
      "message_id": 1,
      "from": {
        "id": 123456789,
        "first_name": "Test"
      },
      "chat": {
        "id": 380049174,
        "type": "private"
      },
      "date": 1703520000,
      "text": "/ayuda"
    }
  }
}

settings {
  encodeUrl: false
  timeout: 0
}
