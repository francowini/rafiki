meta {
  name: Delete Value
  type: http
  seq: 14
}

delete {
  url: {{base-url}}/v1/values/{{value-id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt-token}}
}

tests {
  test("should return 204 or 200", function() {
    expect([200, 204]).to.include(res.status);
  });
}

docs {
  # Delete Value

  Deletes a value permanently.

  Only the owner can delete their values.

  Returns 204 No Content on success.
}
