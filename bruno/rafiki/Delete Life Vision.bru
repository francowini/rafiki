meta {
  name: Delete Life Vision
  type: http
  seq: 24
}

delete {
  url: {{base-url}}/v1/lifevisions/{{lifevision-id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt-token}}
}

tests {
  test("should return 204 or 200", function() {
    expect([200, 204]).to.include(res.status);
  });
}

docs {
  # Delete Life Vision

  Deletes a life vision permanently.

  Only the owner can delete their life visions.

  Returns 204 No Content on success.
}
